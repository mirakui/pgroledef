{
  "version": 1,
  "target": {
    "engine": "aurora-postgresql",
    "identifier": "production-shopfront"
  },
  "policy": {
    "authoritative": true,
    "protected_roles": [
      "postgres",
      "rdsadmin",
      "rds_*",
      "pg_*",
      "admin"
    ],
    "unmanaged_databases": [
      "postgres",
      "rdsadmin",
      "template*"
    ]
  },
  "roles": [
    {
      "name": "grp_shopfront_reader",
      "login": false,
      "grants": [
        {
          "on": {
            "database": "shopfront"
          },
          "privileges": [
            "CONNECT"
          ]
        },
        {
          "on": {
            "schema": "shopfront.public"
          },
          "privileges": [
            "USAGE"
          ]
        },
        {
          "on": {
            "all_tables_in_schema": "shopfront.public"
          },
          "privileges": [
            "SELECT"
          ]
        }
      ],
      "default_privileges": [
        {
          "for_role": "shopfront_migrator",
          "in_schema": "shopfront.public",
          "on": "tables",
          "privileges": [
            "SELECT"
          ]
        }
      ]
    },
    {
      "name": "grp_shopfront_writer",
      "login": false,
      "member_of": [
        "grp_shopfront_reader"
      ],
      "grants": [
        {
          "on": {
            "schema": "shopfront.public"
          },
          "privileges": [
            "USAGE",
            "CREATE"
          ]
        },
        {
          "on": {
            "all_tables_in_schema": "shopfront.public"
          },
          "privileges": [
            "SELECT",
            "INSERT",
            "UPDATE",
            "DELETE"
          ]
        },
        {
          "on": {
            "all_sequences_in_schema": "shopfront.public"
          },
          "privileges": [
            "USAGE",
            "SELECT"
          ]
        }
      ],
      "default_privileges": [
        {
          "for_role": "shopfront_migrator",
          "in_schema": "shopfront.public",
          "on": "sequences",
          "privileges": [
            "USAGE",
            "SELECT"
          ]
        },
        {
          "for_role": "shopfront_migrator",
          "in_schema": "shopfront.public",
          "on": "tables",
          "privileges": [
            "SELECT",
            "INSERT",
            "UPDATE",
            "DELETE"
          ]
        }
      ]
    },
    {
      "name": "shopfront_migrator",
      "login": true,
      "member_of": [
        "grp_shopfront_writer",
        "rds_iam"
      ],
      "creates_objects_in": [
        "shopfront.public"
      ]
    },
    {
      "name": "shopfront_api",
      "login": true,
      "member_of": [
        "grp_shopfront_writer",
        "rds_iam"
      ]
    },
    {
      "name": "shopfront_worker",
      "login": true,
      "grants": [
        {
          "on": {
            "database": "shopfront"
          },
          "privileges": [
            "CONNECT"
          ]
        },
        {
          "on": {
            "schema": "shopfront.public"
          },
          "privileges": [
            "USAGE"
          ]
        },
        {
          "on": {
            "table": "shopfront.public.job_queue"
          },
          "privileges": [
            "SELECT",
            "INSERT",
            "UPDATE"
          ]
        }
      ]
    },
    {
      "name": "shopfront_worker_clone",
      "login": true,
      "grants": [
        {
          "on": {
            "database": "shopfront"
          },
          "privileges": [
            "CONNECT"
          ]
        },
        {
          "on": {
            "schema": "shopfront.public"
          },
          "privileges": [
            "USAGE"
          ]
        },
        {
          "on": {
            "table": "shopfront.public.job_queue"
          },
          "privileges": [
            "SELECT",
            "INSERT",
            "UPDATE"
          ]
        }
      ]
    },
    {
      "name": "bi_readonly",
      "login": true,
      "member_of": [
        "grp_shopfront_reader"
      ]
    }
  ]
}
